{
  "name": "committee-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node server.mjs",
    "check": "node --check web/app.mjs && node --check web/engine.mjs && node --check worker/index.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/build.mjs && npx --yes wrangler@4.151.1 deploy -c proxy/wrangler.toml",
    "review:code": "node scripts/code-review.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "drizzle-orm": "0.45.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25.0"
  }
}
