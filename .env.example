# Local setup only. Production values are registered as Site secrets (legacy) or `wrangler secret put` (Cloudflare).
# Cloudflare Access identity check inside the Worker. All four are required; a missing value rejects every request.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=
OWNER_EMAIL=
ACCESS_SERVICE_ID=
# Legacy ChatGPT Sites deployments only. Never set this on Cloudflare.
# AUTH_PROVIDER=sites
# Updater and reviewer clients on Cloudflare: Access service token instead of COMMITTEE_SITE_TOKEN.
COMMITTEE_ACCESS_CLIENT_ID=
COMMITTEE_ACCESS_CLIENT_SECRET=
DART_API_KEY=
EDINET_API_KEY=
FRED_API_KEY=
# US-only SEC filing collection and optional paid Jev prioritization.
TYPESAFE_API_KEY=
# Announce the authorized US two-stage shadow pilot to the research controller.
JEV_PILOT_ENABLED=false
# Use your real contact email: CommitteeInvestmentLab contact@example.com
SEC_USER_AGENT=
# Server and local build: independently registered public RSA JWK, not a receipt's key.
CLAUDE_REVIEW_PUBLIC_KEY=
# Local private PEM outside the repository. Same-user model file access is NOT isolated.
COMMITTEE_REVIEW_KEY=
# Cloud runtime verifier only. Keep false until a real auth-check passes.
CLOUD_REVIEW_ENABLED=false
CLOUD_REVIEW_REPOSITORY=fdo2a/portfolio-investment
CLOUD_REVIEW_REF=cloud-investment
CLOUD_REVIEW_DISPATCH_TOKEN=
CLOUD_REVIEW_PUBLIC_KEY=
# GitHub Actions secrets, never Site model input or committed values.
CLAUDE_CODE_OAUTH_TOKEN=
CLOUD_REVIEW_PRIVATE_KEY=
